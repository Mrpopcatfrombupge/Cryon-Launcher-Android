<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings, on the same moving shadow as the front screen. The tabs are built in
  code because which there are is a property of the settings table, not of this
  layout: a new group should appear without a layout file being edited.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shadow_black">

    <dev.cryon.client.ShadowBackdrop
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include layout="@layout/bar" />

        <EditText
            android:id="@+id/settings_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:hint="Search all settings"
            android:singleLine="true"
            android:textColor="@color/shadow_silver"
            android:textColorHint="@color/shadow_mist"
            android:textSize="15sp"
            android:inputType="text" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_h"
            android:background="@color/shadow_charcoal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="@dimen/pad"
                android:paddingEnd="@dimen/pad" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                android:background="@drawable/card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
