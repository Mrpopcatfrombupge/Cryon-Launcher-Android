<?xml version="1.0" encoding="utf-8"?>
<!-- A setting with choices: the name, and the one it is on as a chip you tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_h"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/cryon_silver"
        android:textSize="@dimen/text_row" />

    <Button
        android:id="@+id/row_choice"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:background="@drawable/chip"
        android:minWidth="120dp"
        android:paddingStart="@dimen/pad"
        android:paddingEnd="@dimen/pad"
        android:textAllCaps="false"
        android:textColor="@color/cryon_silver"
        android:textSize="@dimen/text_row" />
</LinearLayout>
