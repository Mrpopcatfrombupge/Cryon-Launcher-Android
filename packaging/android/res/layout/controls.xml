<?xml version="1.0" encoding="utf-8"?>
<!--
  The control editor, sideways and full-bleed. Pojav's editor is the game's screen
  with the buttons on it and a sheet that slides in from the side, and that is what
  this is: the stage takes the whole area under the bar, and the sheet covers it
  rather than pushing it aside, because what you are placing is on the stage.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shadow_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <ScrollView
            android:id="@+id/sheet"
            android:layout_width="@dimen/sheet_w"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/sidebar"
            android:elevation="24dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/sheet_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shadow_panel"
        android:orientation="horizontal"
        android:padding="@dimen/pad_small">

        <Button
            android:id="@+id/add_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/picker_h"
            android:layout_weight="1"
            android:background="@drawable/play"
            android:elevation="6dp"
            android:textAllCaps="false"
            android:textColor="@color/shadow_black"
            android:textSize="@dimen/text_small"
            android:text="Add button" />

        <Button
            android:id="@+id/export"
            android:layout_width="0dp"
            android:layout_height="@dimen/picker_h"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/pad_small"
            android:background="@drawable/chip"
            android:textAllCaps="false"
            android:textColor="@color/shadow_silver"
            android:textSize="@dimen/text_small"
            android:text="Export" />

        <Button
            android:id="@+id/import_"
            android:layout_width="0dp"
            android:layout_height="@dimen/picker_h"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/pad_small"
            android:background="@drawable/chip"
            android:textAllCaps="false"
            android:textColor="@color/shadow_silver"
            android:textSize="@dimen/text_small"
            android:text="Import" />

        <Button
            android:id="@+id/reset"
            android:layout_width="0dp"
            android:layout_height="@dimen/picker_h"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/pad_small"
            android:background="@drawable/chip"
            android:textAllCaps="false"
            android:textColor="@color/shadow_silver"
            android:textSize="@dimen/text_small"
            android:text="Reset" />
    </LinearLayout>
</LinearLayout>
