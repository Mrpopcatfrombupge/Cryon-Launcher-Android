<?xml version="1.0" encoding="utf-8"?>
<!--
  PLAY: the one bright object on the page. A plate of the accent, slightly lighter
  at the top than the bottom so it catches the light, dark text on it, and a real
  shadow under it from the view's elevation. Everything else on the screen is
  blacker than this, which is what makes the button findable without looking.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/shadow_accent"
                android:endColor="@color/shadow_accent_deep" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_charcoal" />
            <stroke android:width="1dp" android:color="@color/shadow_rule" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A6C8E2"
                android:endColor="@color/shadow_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
