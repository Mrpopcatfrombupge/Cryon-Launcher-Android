<?xml version="1.0" encoding="utf-8"?>
<!--
  The card the choices sit on: charcoal, hairline-rimmed, and lifted off the page
  by the elevation the layout gives it. The rim is what keeps a dark panel on a
  dark background from vanishing into it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_charcoal" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/shadow_rule" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
