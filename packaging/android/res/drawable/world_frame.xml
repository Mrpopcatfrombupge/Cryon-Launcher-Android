<?xml version="1.0" encoding="utf-8"?>
<!--
  The frame a world's picture sits in. Worlds whose save has no icon.png — one
  never opened, or a save from before the game started taking pictures — show the
  globe on this, so every row has the same square of light and the list lines up.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/shadow_slate" />
    <stroke android:width="1dp" android:color="@color/shadow_rule" />
    <corners android:radius="10dp" />
</shape>
