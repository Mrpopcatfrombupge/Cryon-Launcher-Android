<?xml version="1.0" encoding="utf-8"?>
<!-- The sheet that slides over the stage. Opaque: it covers the buttons while you
     set them, and a translucent sheet over the thing you are editing is a mistake
     Pojav does not make. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/shadow_charcoal" />
    <stroke android:width="1dp" android:color="@color/shadow_rule" />
    <corners
        android:topLeftRadius="18dp"
        android:bottomLeftRadius="18dp" />
</shape>
